# Copy to .env and fill in the values, or let start.ps1 / start.sh generate them.
# .env is ignored by Git; never commit real credentials.

# PostgreSQL password (required)
DB_PASSWORD=

# HTTP Basic users (passwords required, usernames optional)
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=
API_VIEWER_USERNAME=viewer
API_VIEWER_PASSWORD=
